# GenJecX Backend Environment Variables
# Copy this file to .env and update values

# Application
APP_NAME=GenJecX Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://genjecx_user:genjecx_password@localhost:5432/genjecx_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Security
SECRET_KEY=your-secret-key-here-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Admin Credentials (CHANGE IN PRODUCTION!)
ADMIN_EMAIL=genjecx@gmail.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ML Configuration
ML_MODEL_PATH=/app/ml/artifacts
ML_INFERENCE_TIMEOUT=30
ML_BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_BATCH_SIZE=100

# External Services (optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Email Notifications (for Gmail SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=genjecx@gmail.com
# SMTP_PASSWORD=your-app-password-here

# File Storage (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=genjecx-content
